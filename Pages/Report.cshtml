@page
@model ReportModel
@{
    ViewData["Title"] = "Report Card";
    ViewData["Heading"] = "Student report card";
}
@if (Model.Student == null) {
    <div class="panel empty-state"><h2>Student not found</h2><p class="muted">The requested student record does not exist.</p><a class="btn btn-primary" asp-page="/Students">Back to students</a></div>
} else {
<div class="report-actions"><a class="text-link" asp-page="/Students">← Back to students</a><button class="btn btn-primary" onclick="window.print()">Print report ↗</button></div>
<div class="report-card">
    <div class="report-top"><div class="brand report-brand"><span class="brand-mark">G</span><span>Grade<span class="brand-light">Flow</span><small>ACADEMIC REPORT</small></span></div><span class="pill report-pill">OFFICIAL RESULT</span></div>
    <div class="report-heading"><span class="eyebrow">STUDENT PERFORMANCE</span><h1>Report Card</h1><p>Academic assessment summary</p></div>
    <div class="report-student"><div class="report-avatar">@Model.Student.Name.Substring(0,1)</div><div><small>STUDENT NAME</small><h2>@Model.Student.Name</h2><span>@Model.Student.StudentId</span></div><div class="grade-large grade-@Model.Student.Grade.ToLower()"><small>FINAL GRADE</small><strong>@Model.Student.Grade</strong></div></div>
    <div class="report-metrics"><div><small>TOTAL MARKS</small><strong>@Model.Total <span>/ 500</span></strong></div><div><small>AVERAGE</small><strong>@Model.Average.ToString("0.0")<span>%</span></strong></div><div><small>RESULT</small><strong class="result-@Model.Student.Result.ToLower().Replace(" ", "-")">@Model.Student.Result</strong></div></div>
    <h3 class="report-section-title">Subject-wise performance</h3>
    <table class="report-table"><thead><tr><th>SUBJECT</th><th>MARKS OBTAINED</th><th>MAXIMUM MARKS</th><th>STATUS</th></tr></thead><tbody>
    @for(int i=0;i<5;i++){<tr><td>Subject @(i+1)</td><td><b>@Model.Student.Marks[i]</b></td><td>100</td><td><span class="grade @(Model.Student.Marks[i] >= 50 ? "grade-a" : "grade-f")">@(Model.Student.Marks[i] >= 50 ? "Passed" : "Below 50")</span></td></tr>}
    </tbody></table>
    <div class="report-footer"><span>Generated by GradeFlow Student Portal</span><span>Keep learning. Keep growing. ✦</span></div>
</div>
}
